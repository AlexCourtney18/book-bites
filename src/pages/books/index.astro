---
import BaseLayout from "../../layouts/BaseLayout.astro";

interface Book {
  title: string;
  author: string;
}

const books: Book[] = [
  { title: "The Name of The Wind", author: "Patrick Rothfuss" },
  { title: "The Final Empire", author: "Brendon Sanderson" },
  { title: "The Blade Itself", author: "Joe Abercrombie" },
  { title: "The Will of the Many", author: "James Islington" },
];
---

<BaseLayout>
  <div class="content">
    <h2>Books</h2>
    {
      books.map((book) => {
        return (
          <div class="book-card">
            <p class="book-title">{book.title}</p>
            <p class="book-author">{book.author}</p>
          </div>
        );
      })
    }
    {books.length < 1 && <p>No books to show.</p>}
  </div>
</BaseLayout>

<style>
  h2 {
    padding-right: 10px;
    border-right: 0.5rem solid #ebe5f2;
    border-bottom: 0.5rem solid #f9f6fc;
    margin-bottom: 2.5rem;
    text-align: right;
  }
  .book-card {
    background-color: #f9f6fc;
    padding: 1rem 1.25rem;
    margin: 1.25rem auto;
    box-shadow: 0.5rem 0.5rem 0 #ebe5f2;
  }
  .book-title {
    font-size: 1.4em;
    font-weight: bold;
    margin: 0;
  }
  .book-author {
    margin-top: 0;
  }
</style>
